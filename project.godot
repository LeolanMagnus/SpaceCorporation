; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpaceCorporation"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

DebugInfoBus="*res://scripts/core/DebugInfoBus.cs"

[dotnet]

project/assembly_name="SpaceCorporation"

[input]

debug_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194334,"physical_keycode":4194334,"key_label":4194334,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="Ship"
3d_physics/layer_2="Station"
3d_physics/layer_3="Character"
3d_physics/layer_4="Target"
3d_physics/layer_5="DockingZone"
3d_physics/layer_6="DebugHelper"

[physics]

3d/default_gravity=0.0
