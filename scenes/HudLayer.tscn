[ext_resource type="Script" path="res://scripts/ui/TargetingService.cs" id="3_targeting"]
[ext_resource type="Script" path="res://scripts/ui/TargetMarker.cs" id="4_marker"]

; HUD в стиле X4 (hud-plan.md). Слой 5 — НИЖЕ DebugLayer (слой 10): панель F3
; никогда не перекрывается HUD, слои не конфликтуют (§5 плана).
;
; Правило размещения (требование: всё влезает в экран, текст переносится):
;  • каждая панель прижата к своему углу якорями (anchor_*), offset задан
;    ОТ угла — при любом размере окна панели остаются в углах;
;  • у каждой панели фиксированная ширина (custom_minimum_size + кламп по
;    offset), у Label стоит autowrap_mode = 3 (word) — длинный текст
;    переносится, а не распирает панель;
;  • статус-бар снизу не растягивается шире своего содержимого
;    (grow_horizontal = 0/1 от нужного края).
;
; HudRoot — Control на весь экран с mouse_filter = 2 (Ignore): HUD не eat-click
; мышью, прицеливание и стыковка работают сквозь него. Сами панели — PanelContainer
; (по умолчанию mouse_filter у PanelContainer = Stop) — но они в углах и на пути
; курсора не стоят; при сомнениях — Ignore на конкретной панели.
[node name="HudLayer" type="CanvasLayer"]
layer = 5
script = ExtResource("1_hud")

; ─── Выбор цели (H3): сервис — узел-логика (не Control), маркер — Control
; во весь экран поверх всего HUD, рисуется кодом (TargetMarker.cs).
[node name="TargetingService" type="Node" parent="."]
script = ExtResource("3_targeting")

[node name="HudRoot" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; ───────── Центр: прицельная марка (рисуется кодом, Crosshair.cs) ─────────
